# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Optional: restrict slash command sync to one server while developing (faster than global sync)
DISCORD_DEV_GUILD_ID=

# UEX Corp API 2.0 app token, created on the "My Apps" page at https://uexcorp.space
UEX_APP_TOKEN=

# OPTIONAL / legacy fallback only. Each Discord user should link their own UEX account
# in-app with /link-uex-account instead (needed for multi-user servers). This value, if
# set, is only used as a fallback and is NOT how normal users authenticate.
UEX_SECRET_KEY=

# Path to the SQLite database file (created automatically if missing)
DATABASE_PATH=data/uexbot.sqlite3
