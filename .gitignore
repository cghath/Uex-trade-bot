# Secrets & local config — never commit (.env holds the Discord/UEX tokens)
.env

# Runtime data: SQLite DB and the Fernet encryption key. Sensitive — keep local only.
data/

# Pre-deploy DB snapshots from scripts/deploy_and_backup.sh - same sensitivity as data/.
backups/

# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Local investigation notes and one-off UEX API captures. Keep these on the
# developer machine; reusable diagnostic tools belong in scripts/ instead.
/CLAUDE.local.md
/diagnose.py
/categories.txt
/dump.txt
/itemstats.txt
/savrilium.txt
/stileron.txt
